# Supabase project (local: `supabase status`; hosted: project settings → API keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The worker's public address: the browser calls it directly (approvals, accounts, takeover).
NEXT_PUBLIC_WORKER_URL=http://127.0.0.1:8000
# Cloudflare Turnstile site key. 1x00000000000000000000AA is Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only (never NEXT_PUBLIC_). Twilio signs webhooks with the account Auth Token.
TWILIO_AUTH_TOKEN=
# Public origin Twilio calls, e.g. https://agent.example.com (used to verify signatures).
PUBLIC_BASE_URL=http://localhost:3000
# Worker internal API and the shared request-signing secret (same value as WORKER_SERVICE_HMAC_SECRET).
WORKER_URL=http://localhost:8000
SERVICE_HMAC_SECRET=
# Web push: the public half of the VAPID key pair (the private half is WORKER_VAPID_PRIVATE_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
